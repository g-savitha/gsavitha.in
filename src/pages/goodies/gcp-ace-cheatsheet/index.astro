---
import { getEntry, render } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import MindMapSection from '../../../components/goodies/MindMapSection.astro';
import { SITE_TITLE } from '../../../consts';
import { ArrowLeft, Download, ExternalLink } from 'lucide-astro';

const pdfUrl = '/gcp-ace-cheatsheet.pdf';
const downloadFilename = 'gcp-ace-cheatsheet.pdf';

const entry = await getEntry('goodies', 'gcp-ace-cheatsheet');
if (!entry?.body) {
  throw new Error('Missing goodies entry body: gcp-ace-cheatsheet');
}
const { Content } = await render(entry);
---

<PageLayout title={`${entry.data.title} | ${SITE_TITLE}`} description={entry.data.description}>
  <article class="pdf-document">
    <a href="/goodies" class="pdf-document__back-link hover-lift">
      <ArrowLeft class="pdf-document__action-icon" aria-hidden="true" />
      Goodies
    </a>

    <header class="pdf-document__header">
      <div>
        <h1 class="pdf-document__title">{entry.data.title}</h1>
        <p class="pdf-document__description">
          A visual mind map covering all key topics for the Google Cloud Associate Cloud Engineer
          exam.
        </p>
      </div>

      <nav class="pdf-document__actions" aria-label="PDF actions">
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="pdf-document__action hover-lift"
        >
          <ExternalLink class="pdf-document__action-icon" aria-hidden="true" />
          Open PDF
        </a>
        <a href={pdfUrl} download={downloadFilename} class="pdf-document__action hover-lift">
          <Download class="pdf-document__action-icon" aria-hidden="true" />
          Download PDF
        </a>
      </nav>
    </header>

    <MindMapSection
      markdown={entry.body}
      label={`${entry.data.title} mind map`}
      fallbackHint="Use the text outline below or download the PDF."
    >
      <Content />
    </MindMapSection>
  </article>
</PageLayout>
