---
import { getEntry, render } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import { SITE_TITLE } from '../../../consts';
import { ArrowLeft, ExternalLink } from 'lucide-astro';

const sourceUrl = 'https://github.com/g-savitha/ai-stuff/blob/main/cheatsheets/pstack.md';

const entry = await getEntry('goodies', 'pstack-cheatsheet');
if (!entry) {
  throw new Error('Missing goodies entry: pstack-cheatsheet');
}
const { Content } = await render(entry);
---

<PageLayout title={`${entry.data.title} | ${SITE_TITLE}`} description={entry.data.description}>
  <article class="pdf-document">
    <a href="/goodies" class="pdf-document__back-link hover-lift">
      <ArrowLeft class="pdf-document__action-icon" aria-hidden="true" />
      Goodies
    </a>

    <header class="pdf-document__header">
      <div>
        <h1 class="pdf-document__title">{entry.data.title}</h1>
        <p class="pdf-document__description">
          {entry.data.description}
        </p>
      </div>

      <nav class="pdf-document__actions" aria-label="Cheat sheet actions">
        <a
          href={sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="pdf-document__action hover-lift"
        >
          <ExternalLink class="pdf-document__action-icon" aria-hidden="true" />
          View source on GitHub
        </a>
      </nav>
    </header>

    <div class="markdown-document prose">
      <Content />
    </div>
  </article>
</PageLayout>
