---
import MindMap, { type MindMapProps } from './MindMap';
import { outlineToMindmap } from '../../utils/mindmap';

/**
 * Interactive mind map built from a Markdown nested list, plus a no-JS notice and an optional
 * collapsible text outline. Pass the outline as the default slot (for example a content
 * entry's `<Content />`); omit the slot to render the map alone.
 */
type Props = Omit<MindMapProps, 'root'> & {
  /** Markdown nested list with one top-level item, such as a content entry's `body`. */
  markdown: string;
  /** Summary label of the text outline. Default `Text outline`. */
  outlineSummary?: string;
};

const { markdown, outlineSummary = 'Text outline', fallbackHint, ...mapProps } = Astro.props;
const hasOutline = Astro.slots.has('default');
const hint = fallbackHint ?? (hasOutline ? 'Use the text outline below.' : undefined);
const noscriptMessage = ['The interactive map needs JavaScript.', hint].filter(Boolean).join(' ');
const root = outlineToMindmap(markdown);
---

<MindMap client:visible root={root} fallbackHint={hint} {...mapProps} />
{
  (
    /* @astrojs/compiler parses a bare <noscript> after a root component in "in head" mode
       and nests every later sibling inside it. The expression keeps it separate. */
    <noscript>
      <p class="mindmap__noscript">{noscriptMessage}</p>
    </noscript>
  )
}

{
  hasOutline && (
    <details class="mindmap-outline">
      <summary class="mindmap-outline__summary">{outlineSummary}</summary>
      <div class="markdown-document prose mindmap-outline__body">
        <slot />
      </div>
    </details>
  )
}
