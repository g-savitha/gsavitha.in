---
import { parseEmbedUrl } from '../utils/embed';

/**
 * Embeds an X post or a YouTube video from its URL. Usable in `.mdx` posts
 * without an import: the blog route passes it through `<Content components>`.
 */
type Props = {
  /** An X post (`x.com/<user>/status/<id>`) or any YouTube video link. */
  url: string;
  /** Accessible name: the iframe title for YouTube, the fallback text for X. */
  title: string;
  /** Optional line shown under the embed. */
  caption?: string;
};

const { url, title, caption } = Astro.props;
const target = parseEmbedUrl(url);
---

<figure class="embed not-prose" data-embed={target.provider}>
  {
    target.provider === 'youtube' ? (
      <div class="embed-video">
        <iframe
          class="embed-video__frame"
          src={target.embedUrl}
          title={title}
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      </div>
    ) : (
      <blockquote class="twitter-tweet embed-post" data-theme="dark" data-dnt="true">
        <p>{title}</p>
        <a href={target.postUrl}>View the post on X</a>
      </blockquote>
    )
  }
  {caption && <figcaption class="embed-caption">{caption}</figcaption>}
</figure>

<script>
  import { X_WIDGETS_SRC } from '../utils/embed';

  // Astro bundles this once per page however many embeds render, and the
  // widget script is only fetched when the page actually has an X post.
  if (document.querySelector('[data-embed="x"]')) {
    const script = document.createElement('script');
    script.src = X_WIDGETS_SRC;
    script.async = true;
    document.head.append(script);
  }
</script>
